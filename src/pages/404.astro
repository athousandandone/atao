---
// The 404, restyled into the blog's design language at Slice 5 (it was
// a bare port of the hand-authored page until the design system
// existed). It serves misses site-wide, so it carries no chrome tied to
// a section — a centred statement, the routes that exist, the MI
// device. No canonical or Open Graph URL: an error page has no
// canonical address (path is null).
import BlogShell from '../layouts/BlogShell.astro';
---

<BlogShell title="Page not found" description="There is no page at this address." path={null}>
  <main class="not-found">
    <p class="kicker">Page not found</p>
    <h1>There is no page at this address.</h1>
    <p class="return">
      <a href="/">A Thousand And One</a>
      · <a href="/blog/">The Blog</a>
      · <a href="/blog/archive/">Archive</a>
    </p>
    <img src="/blog/mi-plain.svg" alt="" width="30" height="30" />
  </main>
</BlogShell>
