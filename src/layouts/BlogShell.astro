---
// Blog document shell: head, language and stylesheet set only. The index
// and article compose their own chrome (design 2a and 2b carry different
// headers), so the body is a bare slot. Blog styles are imported only
// here — never by the homepage. Blog-internal links are root-absolute
// with trailing slashes.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/blog-base.css';
import '../styles/components.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
