---
// Blog document shell: head, language and stylesheet set only. The index
// and article compose their own chrome (design 2a and 2b carry different
// headers), so the body is a bare slot. Blog styles are imported only
// here — never by the homepage. Blog-internal links are root-absolute
// with trailing slashes. The head carries the reviewed metadata set
// (HeadMeta), the homepage's icon and manifest block restated with
// root-absolute paths, and feed autodiscovery.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/blog-base.css';
import '../styles/components.css';
import '../styles/print.css';
import HeadMeta from '../components/HeadMeta.astro';
import { title as siteTitle } from '../site';

interface Props {
  title: string;
  description: string;
  path: string | null;
  ogType?: 'website' | 'article';
  imagePath?: string;
  publishedTime?: string;
}

const { title, description, path, ogType, imagePath, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadMeta
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      imagePath={imagePath}
      publishedTime={publishedTime}
    />
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="1001" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/blog/rss.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
