---
// Article page implementing approved design 2b: compact identity bar,
// centred title block (kicker = first tag by the Editor's ruling, no
// reading time), byline from site configuration, the reading column
// with sidenote gutter, and adjacent-article navigation. Dates are
// civil and displayed en-GB, pinned to UTC. Tags in "Filed under" link
// to their tag routes (Slice 5).
import type { CollectionEntry } from 'astro:content';
import BlogShell from './BlogShell.astro';
import PrevNext from '../components/PrevNext.astro';
import { byline } from '../site';
import { formatDateLong, isoDay } from '../lib/dates';
import { withEndMark } from '../lib/end-mark.mjs';
import { tagSlug } from '../lib/tag-slug';
import '../styles/prose.css';

interface Props {
  entry: CollectionEntry<'blog'>;
  older: CollectionEntry<'blog'> | null;
  newer: CollectionEntry<'blog'> | null;
}

const { entry, older, newer } = Astro.props;
const { data } = entry;
const kicker = data.tags?.[0];

// The end-mark is placed into the rendered HTML (see end-mark.mjs); a
// collection entry without rendered HTML would be a build defect.
if (typeof entry.rendered?.html !== 'string') {
  throw new Error(`entry "${entry.id}" has no rendered HTML`);
}
const body = withEndMark(entry.rendered.html);
---

<BlogShell title={`${data.title} — A Thousand And One`}>
  <header class="article-bar">
    <a href="/blog/"
      ><img src="/blog/wordmark.png" alt="A Thousand And One" width="391" height="131" /></a
    >
    <nav>
      <a href="/blog/">The Blog</a>
      <a href="/blog/archive/">Archive</a>
      <a href="/blog/about/">About</a>
    </nav>
  </header>
  <main>
    <article class="article">
      <header class="article-head">
        {kicker && <p class="kicker">{kicker}</p>}
        <h1>{data.title}</h1>
        <p class="standfirst">{data.standfirst}</p>
        <p class="byline">
          By {byline} · <time datetime={isoDay(data.date)}>{formatDateLong(data.date)}</time>
        </p>
      </header>
      <div class="article-column">
        <div class="prose" set:html={body} />
        {
          data.tags && data.tags.length > 0 && (
            <footer class="filed-under">
              Filed under:{' '}
              {data.tags.map((tag, i) => (
                <Fragment>
                  {i > 0 && ' · '}
                  <a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a>
                </Fragment>
              ))}
            </footer>
          )
        }
      </div>
      <PrevNext older={older} newer={newer} />
    </article>
  </main>
</BlogShell>
